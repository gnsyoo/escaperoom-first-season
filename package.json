{
  "name": "pyoryudo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package-runtime-art.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.ts",
    "check:content": "node scripts/check-content.mjs",
    "check:art": "node scripts/build-art-pack.mjs --verify-complete",
    "gallery": "node scripts/serve-art.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "pretendard": "1.3.9",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
